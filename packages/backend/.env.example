# すべて必須（無ければ起動時にエラーになる）
PORT=8787

# LiteLLM（調査エージェント・要約・Gemini Live のパススルー）
LITELLM_BASE_URL=https://litellm.wpcapp.net
LITELLM_API_KEY=
LITELLM_MODEL=auto
# 結果の要約に使うモデル。応答の速いものを選ぶ（sakura/auto で 5.6〜8.1 秒、auto は 40 秒以上かかった）
LITELLM_SUMMARY_MODEL=sakura/auto

# bare-web-proxy（Web 検索・ページ取得）
BWPROXY_URL=https://bwproxy.wpcapp.net

# Gemini Live のモデル（動作確認済み: models/gemini-3.8-live）
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# 任意: Gemini Live WebSocket プロキシの URL（未指定時は LITELLM_BASE_URL から導出）
# k8s クラスタ内では gemini-live-proxy サービスを指定する
# GEMINI_LIVE_BASE_URL=http://gemini-live-proxy.litellm.svc.cluster.local:8080
