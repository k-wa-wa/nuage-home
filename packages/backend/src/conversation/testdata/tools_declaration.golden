[
  {
    "name": "add_task",
    "description": "照明やカーテンなどの家電操作、Web検索や詳しい調査、開発タスクの確認など、利用できるアプリに作業を依頼する。結果は後で通知として届く。",
    "parameters": {
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "description": "依頼内容（ユーザーの言葉や状況から汲み取った具体的な作業内容）"
        },
        "app": {
          "type": "string",
          "description": "依頼先のアプリ名（research: Web 検索を使った詳しい調査・分析・比較、autopilot: 開発タスクの自律実行・PR の作成や進捗確認）",
          "enum": [
            "research",
            "autopilot"
          ]
        }
      },
      "required": [
        "instruction"
      ]
    }
  },
  {
    "name": "task_status",
    "description": "頼んだ作業の進み具合と結果を確認する",
    "parameters": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "cancel_task",
    "description": "頼んだ作業を取り消す。対象を省略すると直近の作業を取り消す",
    "parameters": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "取り消す作業を特定する言葉"
        }
      }
    }
  }
]